{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ICU场外照护举证领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CLAIM_OPENED",
        "RULE_VERSION_PINNED",
        "EVIDENCE_SUBMITTED",
        "EVIDENCE_MERGED",
        "HOSPITALIZATION_RECORDED",
        "MEDICAL_CARE_ITEM_RECORDED",
        "LIVING_CARE_NEED_RECORDED",
        "FAMILY_ACTIVITY_RECORDED",
        "EXPERT_OPINION_RECORDED",
        "CARE_CLASSIFIED",
        "CALCULATION_FROZEN",
        "DECISION_ISSUED",
        "REVIEW_OPENED",
        "FOLLOWUP_RESULT_RECORDED",
        "DECISION_REVISED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "injury_claim",
        "hospitalization_phase",
        "care_item",
        "care_evidence",
        "living_care_need",
        "family_activity",
        "expert_opinion",
        "care_classification",
        "calculation_snapshot",
        "review_decision"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
