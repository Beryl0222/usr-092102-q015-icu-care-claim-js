{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ICU场外照护举证领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "EVIDENCE_SUBMITTED",
        "CARE_CLASSIFIED",
        "CALCULATION_FROZEN",
        "DECISION_ISSUED",
        "DECISION_REVISED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "injury_claim",
        "care_evidence",
        "calculation_snapshot",
        "review_decision"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
